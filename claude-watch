else { $audio = '<audio silent="true"/>' }
$body = '<toast><visual><binding template="ToastGeneric"><text>' + (Esc $env:CW_TITLE) +
  '</text><text>' + (Esc $env:CW_SUBTITLE) + '</text><text>' + (Esc $env:CW_MESSAGE) +
