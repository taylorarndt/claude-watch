def ordered_sessions(state: dict) -> list[dict]:
    sessions = list(state["sessions"].values())
    waiting = [s for s in sessions if s.get("status") == "waiting"]
    other = [s for s in sessions if s.get("status") != "waiting"]
    waiting.sort(key=lambda s: s.get("since", 0))
    other.sort(key=lambda s: (s.get("project") or "", s.get("updated", 0)))
    return waiting + other


def cmd_status(args: list[str]) -> int:
    state = with_state()
    sessions = ordered_sessions(state)

    if "--json" in args:
        print(json.dumps(sessions, indent=2))
        return 0

    if not sessions:
        print("No Claude Code sessions tracked.")
        print("Start a session (or run `claude-watch install` first).")
        return 0

    now = time.time()
    waiting = [s for s in sessions if s.get("status") == "waiting"]
    print(f"{len(waiting)} of {len(sessions)} session(s) waiting on you.\n")

    for index, sess in enumerate(sessions, start=1):
        if sess.get("status") == "waiting":
            ntype = sess.get("notification_type", "unknown")
            waited = fmt_duration(now - sess.get("since", now))
            head = f"{index}. WAITING {waited}: {TITLES.get(ntype, ntype)}"
        else:
            head = f"{index}. ok"
        print(head)
        print(f"     project: {sess.get('project') or '?'}  ({sess.get('cwd') or '?'})")
        if sess.get("status") == "waiting" and sess.get("message"):
            print(f"     says:    {sess['message']}")
        bits = []
        if sess.get("tty"):
            bits.append(sess["tty"])
        if sess.get("term_app"):
            bits.append(sess["term_app"])
        if sess.get("permission_mode"):
            bits.append(f"mode={sess['permission_mode']}")
        if bits:
            print(f"     where:   {'  '.join(bits)}")
        print(f"     session: {sess.get('session_id', '?')}")
        print()

    if waiting:
        print("Jump to the first one with:  claude-watch focus 1")
    return 0


def cmd_log(args: list[str]) -> int:
    count = 20
    for flag in ("-n", "--count"):
        if flag in args:
            count = int(args[args.index(flag) + 1])
    try:
        lines = EVENTS_PATH.read_text().splitlines()
    except OSError:
        print("No history yet.")
        return 0

    records = []
    for line in lines[-count * 4:]:
        try:
            records.append(json.loads(line))
        except ValueError:
            continue

    if "--json" in args:
        print(json.dumps(records[-count:], indent=2))
        return 0

    if not records:
        print("No history yet.")
        return 0

    for rec in records[-count:]:
        when = time.strftime("%m-%d %H:%M:%S", time.localtime(rec.get("at", 0)))
        project = rec.get("project") or "?"
        event = rec.get("event")
        if event == "notification":
            kind = "waited on" if rec.get("waiting") else "noted"
            detail = rec.get("message") or rec.get("notification_type", "")
            print(f"{when}  {project:<22} {kind}: {detail}")
        elif event == "resolved":
            waited = fmt_duration(rec.get("waited_seconds", 0))
            reminders = rec.get("reminders", 0)
            extra = f", {reminders} reminder(s)" if reminders else ""
            print(f"{when}  {project:<22} answered after {waited}{extra} "
                  f"({rec.get('notification_type', '?')})")
        elif event == "reminder":
            waited = fmt_duration(rec.get("waited_seconds", 0))
            print(f"{when}  {project:<22} still waiting ({waited})")
        elif event == "dropped":
            print(f"{when}  {project:<22} forgotten ({rec.get('reason')})")
        elif event == "session_end":
            print(f"{when}  {project:<22} session ended ({rec.get('reason') or 'n/a'})")
        else:
            print(f"{when}  {project:<22} {event}")

    waits = [r.get("waited_seconds", 0) for r in records if r.get("event") == "resolved"]
    if waits:
        print(f"\n{len(waits)} answered prompt(s) in this window; "
              f"longest wait {fmt_duration(max(waits))}, "
              f"average {fmt_duration(sum(waits) / len(waits))}.")
    return 0


def cmd_focus(args: list[str]) -> int:
    if not args:
        print("usage: claude-watch focus <number | session-id | project>")
        return 2
    target = args[0]
    sessions = ordered_sessions(with_state())
    if not sessions:
        print("No sessions tracked.")
        return 1

    match = None
    if target.isdigit() and 1 <= int(target) <= len(sessions):
        match = sessions[int(target) - 1]
    else:
        for sess in sessions:
            if sess.get("session_id", "").startswith(target) or sess.get("project") == target:
                match = sess
                break
    if match is None:
        print(f"No session matching {target!r}. Try `claude-watch status`.")
        return 1

    print(focus_session(match))
    return 0


def cmd_clear(args: list[str]) -> int:
    def mutate(state):
