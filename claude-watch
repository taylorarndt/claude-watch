def _spawn(cmd: list[str], env: dict | None = None) -> None:
    """Fire and forget -- a hook must never block Claude Code."""
    detach = {"start_new_session": True}
    if IS_WINDOWS:
        detach = {"creationflags": subprocess.CREATE_NO_WINDOW
                  | subprocess.CREATE_NEW_PROCESS_GROUP}
    try:
        subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env={**os.environ, **env} if env else None,
            **detach,
        )
    except OSError as exc:
        _note_error(f"spawn failed: {cmd[0]}: {exc}")


def chosen_notifier(cfg: dict) -> str:
    choice = cfg.get("notifier", "auto")
    if choice != "auto":
        return choice
    if IS_WINDOWS:
        return "toast"
    return "terminal-notifier" if shutil.which("terminal-notifier") else "osascript"


