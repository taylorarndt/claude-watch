# --------------------------------------------------------------------------
# config + state
# --------------------------------------------------------------------------

def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        user = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return cfg
    for key, value in user.items():
        if isinstance(value, dict) and isinstance(cfg.get(key), dict):
            cfg[key].update(value)
        else:
            cfg[key] = value
    return cfg


def _read_state() -> dict:
    try:
        state = json.loads(STATE_PATH.read_text())
    except (OSError, ValueError):
        state = {}
    state.setdefault("sessions", {})
    return state


def _write_state(state: dict) -> None:
    tmp = STATE_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2))
    tmp.replace(STATE_PATH)
    # A marker file lets the hot-path hooks (PostToolUse) bail out without
    # taking the lock or parsing state when nothing is blocked.
    waiting = any(s.get("status") == "waiting" for s in state["sessions"].values())
    if waiting:
        WAITING_MARKER.touch()
    else:
        WAITING_MARKER.unlink(missing_ok=True)


# msvcrt locks a byte range rather than a file. Locking one far past the end
# keeps the lock from ever colliding with someone reading the real contents.
_LOCK_OFFSET = 1 << 30


def _lock(fh) -> None:
    if IS_WINDOWS:
        fh.seek(_LOCK_OFFSET)
        msvcrt.locking(fh.fileno(), msvcrt.LK_LOCK, 1)
    else:
        fcntl.flock(fh, fcntl.LOCK_EX)


def _unlock(fh) -> None:
    fh.flush()
    if IS_WINDOWS:
        fh.seek(_LOCK_OFFSET)
        msvcrt.locking(fh.fileno(), msvcrt.LK_UNLCK, 1)
    else:
        fcntl.flock(fh, fcntl.LOCK_UN)


def with_state(mutate=None):
    """Run `mutate(state)` under an exclusive lock, persisting any changes."""
    WATCH_HOME.mkdir(parents=True, exist_ok=True)
    with open(LOCK_PATH, "a+") as lock:
        _lock(lock)
        try:
            state = _read_state()
            if mutate is None:
                return state
            result = mutate(state)
            _write_state(state)
            return result
        finally:
            _unlock(lock)


def log_event(record: dict) -> None:
    WATCH_HOME.mkdir(parents=True, exist_ok=True)
    record.setdefault("at", time.time())
    with open(EVENTS_PATH, "a") as fh:
        _lock(fh)
        try:
            fh.write(json.dumps(record) + "\n")
        finally:
            _unlock(fh)


# --------------------------------------------------------------------------
# process / terminal discovery
# --------------------------------------------------------------------------

def _kernel32():
    return ctypes.WinDLL("kernel32", use_last_error=True)


def _proc_table_windows() -> dict[int, tuple[int, str, str]]:
    class Entry(ctypes.Structure):
        _fields_ = [
            ("dwSize", wintypes.DWORD),
            ("cntUsage", wintypes.DWORD),
            ("th32ProcessID", wintypes.DWORD),
            ("th32DefaultHeapID", ctypes.c_size_t),
            ("th32ModuleID", wintypes.DWORD),
            ("cntThreads", wintypes.DWORD),
            ("th32ParentProcessID", wintypes.DWORD),
            ("pcPriClassBase", wintypes.LONG),
            ("dwFlags", wintypes.DWORD),
            ("szExeFile", wintypes.WCHAR * 260),
        ]

    kernel32 = _kernel32()
    kernel32.CreateToolhelp32Snapshot.restype = wintypes.HANDLE
    kernel32.CreateToolhelp32Snapshot.argtypes = [wintypes.DWORD, wintypes.DWORD]
    for walk in (kernel32.Process32FirstW, kernel32.Process32NextW):
        walk.argtypes = [wintypes.HANDLE, ctypes.POINTER(Entry)]
    kernel32.CloseHandle.argtypes = [wintypes.HANDLE]

    snapshot = kernel32.CreateToolhelp32Snapshot(0x2, 0)  # TH32CS_SNAPPROCESS
    if snapshot in (None, wintypes.HANDLE(-1).value):
        return {}
    table: dict[int, tuple[int, str, str]] = {}
    entry = Entry()
    entry.dwSize = ctypes.sizeof(Entry)
    try:
        more = kernel32.Process32FirstW(snapshot, ctypes.byref(entry))
        while more:
            table[entry.th32ProcessID] = (entry.th32ParentProcessID, "", entry.szExeFile)
            more = kernel32.Process32NextW(snapshot, ctypes.byref(entry))
    finally:
        kernel32.CloseHandle(snapshot)
    return table


def _proc_table() -> dict[int, tuple[int, str, str]]:
    if IS_WINDOWS:
        return _proc_table_windows()
    try:
        out = subprocess.run(
            ["ps", "-Ao", "pid=,ppid=,tty=,comm="],
            capture_output=True, text=True, timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    table: dict[int, tuple[int, str, str]] = {}
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 3:
            continue
        try:
            table[int(parts[0])] = (int(parts[1]), parts[2], parts[3] if len(parts) > 3 else "")
        except ValueError:
            continue
    return table


def terminal_identity() -> dict:
    """Figure out which terminal this hook was fired from.

    Walks up from our own pid: the nearest ancestor with a controlling tty is
    the terminal we live in, and the nearest `claude` ancestor is the process
    whose liveness tells us the session still exists.
    """
    table = _proc_table()
    pid = os.getpid()
    tty = None
    claude_pid = None
    for _ in range(12):
        row = table.get(pid)
        if row is None:
            break
        ppid, raw_tty, comm = row
        if tty is None and raw_tty not in ("??", "-", ""):
            tty = raw_tty
        name = os.path.basename(comm).lower()
        # An npm-installed Claude Code shows up as node.exe on Windows.
        if claude_pid is None and ("claude" in name or (IS_WINDOWS and name == "node.exe")):
            claude_pid = pid
        if ppid <= 1:
            break
        pid = ppid
    return {
        "pid": claude_pid,
        "tty": f"/dev/{tty}" if tty else None,
        "term_app": os.environ.get("TERM_PROGRAM")
        or ("WindowsTerminal" if os.environ.get("WT_SESSION") else ""),
        "term_session_id": os.environ.get("TERM_SESSION_ID")
        or os.environ.get("ITERM_SESSION_ID", ""),
        "tmux_pane": os.environ.get("TMUX_PANE", ""),
    }


def pid_alive(pid) -> bool:
    if not pid:
        return True  # unknown: assume alive, let the staleness sweep handle it
    if IS_WINDOWS:
        # Not os.kill(pid, 0): on Windows signal 0 is CTRL_C_EVENT.
        kernel32 = _kernel32()
        kernel32.OpenProcess.restype = wintypes.HANDLE
        kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
        kernel32.GetExitCodeProcess.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
        kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
        try:
            handle = kernel32.OpenProcess(0x1000, False, int(pid))  # QUERY_LIMITED_INFORMATION
        except (ValueError, OverflowError, ctypes.ArgumentError):
            return True
        if not handle:
            return ctypes.get_last_error() != 87  # ERROR_INVALID_PARAMETER: no such pid
        code = wintypes.DWORD()
        ok = kernel32.GetExitCodeProcess(handle, ctypes.byref(code))
        kernel32.CloseHandle(handle)
        return not ok or code.value == 259  # STILL_ACTIVE
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except (PermissionError, ValueError, OverflowError):
        return True
    return True


# --------------------------------------------------------------------------
# notifications
