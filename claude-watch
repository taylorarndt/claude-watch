# (event, matcher). An empty matcher means "every notification type"; "*"
# means "every tool" on the tool events.
HOOK_MATCHERS = [
    ("Notification", ""),
    ("SessionStart", ""),
    ("SessionEnd", ""),
    ("Stop", ""),
    ("PostToolUse", "*"),
    ("UserPromptSubmit", ""),
]


def _windows_command(*parts: str) -> str:
    # The script has no extension, so it runs through the interpreter. Bare
    # forward-slash paths read the same in Git Bash, cmd and PowerShell; quotes
    # are added only when a space forces them.
    parts = tuple(p.replace("\\", "/") for p in parts)
    return " ".join(f'"{p}"' if " " in p else p for p in parts)


if IS_WINDOWS:
    HOOK_COMMAND = _windows_command(sys.executable, str(SELF)) + " hook"
else:
    HOOK_COMMAND = f"{shell_quote(str(SELF))} hook"


def write_default_config() -> None:
    WATCH_HOME.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")


def _is_ours(hook: dict) -> bool:
    command = hook.get("command", "")
    return "claude-watch" in command and command.rstrip().endswith("hook")


def _strip_our_hooks(hooks: dict) -> int:
    """Remove every hook entry this utility owns. Returns how many it removed."""
    removed = 0
    for event in list(hooks.keys()):
        entries = hooks.get(event)
        if not isinstance(entries, list):
            continue
        kept = []
        for entry in entries:
            inner = entry.get("hooks", []) if isinstance(entry, dict) else []
            mine = [h for h in inner if isinstance(h, dict) and _is_ours(h)]
            removed += len(mine)
            theirs = [h for h in inner if h not in mine]
            if theirs:
                entry["hooks"] = theirs
                kept.append(entry)
            elif not inner:
                kept.append(entry)
        if kept:
            hooks[event] = kept
        else:
            hooks.pop(event)
    return removed


def _load_settings() -> dict:
    try:
        return json.loads(SETTINGS_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except ValueError as exc:
        print(f"error: {SETTINGS_PATH} is not valid JSON ({exc}).")
        print("Fix or move that file, then run install again.")
        raise SystemExit(1)


def _save_settings(settings: dict) -> None:
    SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
    if SETTINGS_PATH.exists():
        backup = SETTINGS_PATH.with_suffix(f".json.bak.{int(time.time())}")
        shutil.copy2(SETTINGS_PATH, backup)
        print(f"Backed up settings to {backup}")
    tmp = SETTINGS_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    tmp.replace(SETTINGS_PATH)


def cmd_install(args: list[str]) -> int:
    settings = _load_settings()
    hooks = settings.setdefault("hooks", {})
    _strip_our_hooks(hooks)  # idempotent: re-installing upgrades in place

    for event, matcher in HOOK_MATCHERS:
        entries = hooks.setdefault(event, [])
        entries.append({
            "matcher": matcher,
            "hooks": [{"type": "command", "command": HOOK_COMMAND, "timeout": 10}],
        })

    _save_settings(settings)
    print(f"Registered {len(HOOK_MATCHERS)} hooks in {SETTINGS_PATH}:")
    print("  " + ", ".join(event for event, _ in HOOK_MATCHERS))

    if not CONFIG_PATH.exists():
        write_default_config()
        print(f"Wrote default config to {CONFIG_PATH}")

    if "--no-daemon" in args:
        print("\nSkipping the reminder agent (--no-daemon): you will get one "
              "notification per prompt, with no follow-ups.")
    else:
        install_agent()

    if not IS_WINDOWS and not shutil.which("terminal-notifier"):
        print("\nTip: `brew install terminal-notifier` gives you clickable "
              "notifications (clicking one jumps to that terminal window) and "
              "avoids the Script Editor permission dance.")
    print("\nOpen a new Claude Code session to pick the hooks up, then run "
          "`claude-watch status`.")
    return 0


TASK_XML = '''<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <TimeTrigger>
      <Repetition>
        <Interval>PT1M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2020-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{command}</Command>
      <Arguments>{arguments}</Arguments>
    </Exec>
  </Actions>
</Task>
'''


def _install_task() -> None:
    """The Windows reminder agent: a Task Scheduler job that reaps every minute."""
    # pythonw runs without a console, so the task does not flash a window.
    python = Path(sys.executable)
    windowless = python.with_name("pythonw.exe")
    if windowless.exists():
        python = windowless

    # From XML because the command-line flags cannot turn off "only on AC
    # power", which would silence reminders on a laptop running on battery.
    xml_path = WATCH_HOME / "task.xml"
    WATCH_HOME.mkdir(parents=True, exist_ok=True)
    xml_path.write_text(TASK_XML.format(command=xml_escape(str(python)),
                                        arguments=xml_escape(f'"{SELF}" reap')),
                        encoding="utf-16")
    result = subprocess.run(["schtasks", "/Create", "/TN", TASK_NAME,
                             "/XML", str(xml_path), "/F"],
                            capture_output=True, text=True)
    if result.returncode != 0:
        result = subprocess.run(["schtasks", "/Create", "/TN", TASK_NAME, "/SC", "MINUTE",
                                 "/MO", "1", "/TR", f'"{python}" "{SELF}" reap', "/F"],
                                capture_output=True, text=True)
    if result.returncode == 0:
        print(f"Created scheduled task ({TASK_NAME}): sends reminders while a "
              "session stays blocked.")
    else:
        print(f"Could not create the scheduled task: "
              f"{(result.stderr or result.stdout).strip()}")
        print(f"Run it yourself with: {_windows_command(sys.executable, str(SELF))} daemon")


def install_agent() -> None:
    if IS_WINDOWS:
        return _install_task()
    plist = {
        "Label": LAUNCH_AGENT_LABEL,
        "ProgramArguments": [str(SELF), "reap"],
        "StartInterval": 30,
        "RunAtLoad": True,
        "StandardErrorPath": str(WATCH_HOME / "agent.err.log"),
    }
    LAUNCH_AGENT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(LAUNCH_AGENT_PATH, "wb") as fh:
        plistlib.dump(plist, fh)

    domain = f"gui/{os.getuid()}"
    subprocess.run(["launchctl", "bootout", f"{domain}/{LAUNCH_AGENT_LABEL}"],
                   capture_output=True, text=True)
    result = subprocess.run(["launchctl", "bootstrap", domain, str(LAUNCH_AGENT_PATH)],
                            capture_output=True, text=True)
    if result.returncode != 0:
        result = subprocess.run(["launchctl", "load", "-w", str(LAUNCH_AGENT_PATH)],
                                capture_output=True, text=True)
    if result.returncode == 0:
        print(f"Loaded reminder agent ({LAUNCH_AGENT_LABEL}): sends reminders "
              "while a session stays blocked.")
    else:
        print(f"Could not load the reminder agent: "
              f"{(result.stderr or result.stdout).strip()}")
        print(f"Run it yourself with: {SELF} daemon")


def remove_agent() -> None:
    if IS_WINDOWS:
        result = subprocess.run(["schtasks", "/Delete", "/TN", TASK_NAME, "/F"],
                                capture_output=True, text=True)
        if result.returncode == 0:
            print(f"Removed scheduled task ({TASK_NAME})")
        return
    subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LAUNCH_AGENT_LABEL}"],
                   capture_output=True, text=True)
    if LAUNCH_AGENT_PATH.exists():
        LAUNCH_AGENT_PATH.unlink()
        print(f"Removed {LAUNCH_AGENT_PATH}")


def cmd_uninstall(args: list[str]) -> int:
    settings = _load_settings()
    hooks = settings.get("hooks", {})
    removed = _strip_our_hooks(hooks)
    if not hooks:
        settings.pop("hooks", None)
    if removed:
        _save_settings(settings)
        print(f"Removed {removed} claude-watch hook(s) from {SETTINGS_PATH}")
    else:
        print(f"No claude-watch hooks found in {SETTINGS_PATH}")
    remove_agent()
    print(f"\nState and history are still in {WATCH_HOME}. Delete that "
          "directory to forget everything.")
    return 0


def cmd_doctor(args: list[str]) -> int:
    cfg = load_config()
    settings = _load_settings()
    installed = sorted({
        event
        for event, entries in settings.get("hooks", {}).items()
        if isinstance(entries, list)
        for entry in entries
        if isinstance(entry, dict)
        for hook in entry.get("hooks", [])
        if isinstance(hook, dict) and _is_ours(hook)
    })

    print(f"claude-watch {VERSION}")
    print(f"  script:        {SELF}")
    print(f"  state dir:     {WATCH_HOME}")
    print(f"  settings:      {SETTINGS_PATH}")
    print(f"  hooks:         {', '.join(installed) if installed else 'NOT INSTALLED'}")
    missing = [e for e, _ in HOOK_MATCHERS if e not in installed]
    if installed and missing:
        print(f"  missing hooks: {', '.join(missing)} (re-run `claude-watch install`)")

    notifier = chosen_notifier(cfg)
    print(f"  notifier:      {notifier}" + (
        "" if notifier != "osascript"
        else "  (needs Script Editor notifications enabled)"))
    if not IS_WINDOWS:
        print(f"  terminal-notifier: {shutil.which('terminal-notifier') or 'not installed'}")
    print(f"  speak aloud:   {cfg.get('speak')}")
    print(f"  re-notify:     after {cfg['renag_seconds']}s, gap x{cfg['renag_backoff']} "
          f"each time, up to {cfg['renag_max']} reminder(s)")

    if IS_WINDOWS:
        agent = subprocess.run(["schtasks", "/Query", "/TN", TASK_NAME],
                               capture_output=True, text=True)
    else:
        agent = subprocess.run(["launchctl", "print",
                                f"gui/{os.getuid()}/{LAUNCH_AGENT_LABEL}"],
                               capture_output=True, text=True)
    print(f"  reminder agent: {'loaded' if agent.returncode == 0 else 'not loaded'}")

    sessions = with_state()["sessions"]
    waiting = sum(1 for s in sessions.values() if s.get("status") == "waiting")
    print(f"  tracked:       {len(sessions)} session(s), {waiting} waiting")
    if ERROR_PATH.exists():
        tail = ERROR_PATH.read_text().splitlines()[-3:]
        if tail:
            print("  recent errors:")
            for line in tail:
                print(f"    {line}")
    return 0


