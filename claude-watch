$xml.LoadXml($body)
$toast = New-Object Windows.UI.Notifications.ToastNotification $xml
if ($env:CW_GROUP) { $toast.Tag = $env:CW_GROUP; $toast.Group = 'claude-watch' }
[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier($env:CW_APPID).Show($toast)
'''

SPEAK_SCRIPT = '''
Add-Type -AssemblyName System.Speech
$voice = New-Object System.Speech.Synthesis.SpeechSynthesizer
if ($env:CW_VOICE) { $voice.SelectVoice($env:CW_VOICE) }
$voice.Speak($env:CW_TEXT)
'''


def _powershell(script: str, env: dict) -> None:
    # Windows PowerShell 5.1 specifically: PowerShell 7 cannot load WinRT types.
    encoded = base64.b64encode(script.encode("utf-16-le")).decode("ascii")
    _spawn(["powershell.exe", "-NoProfile", "-NonInteractive",
            "-ExecutionPolicy", "Bypass", "-EncodedCommand", encoded], env)


def notify(cfg: dict, *, title: str, subtitle: str, message: str,
           group: str = "", sound: str = "", click: str = "") -> None:
    kind = chosen_notifier(cfg)
    if IS_WINDOWS:
        if kind != "none":
            if sound and not sound.startswith("Notification."):
                sound = "Notification.Default"  # e.g. a macOS sound name in the config
            _powershell(TOAST_SCRIPT, {
                "CW_TITLE": title, "CW_SUBTITLE": subtitle, "CW_MESSAGE": message,
                "CW_SOUND": sound, "CW_GROUP": group[:64], "CW_APPID": TOAST_APP_ID,
            })
        if cfg.get("speak"):
            spoken = f"{title}. {subtitle}. {message}" if subtitle else f"{title}. {message}"
            _powershell(SPEAK_SCRIPT, {"CW_TEXT": spoken, "CW_VOICE": cfg.get("voice") or ""})
        return

    if kind != "none":
        if kind == "terminal-notifier":
            cmd = ["terminal-notifier", "-title", title,
                   "-subtitle", subtitle, "-message", message]
            if sound:
                cmd += ["-sound", sound]
            if group:
                cmd += ["-group", group]
            if click:
                cmd += ["-execute", click]
        else:
            # Pass text as argv rather than interpolating it into AppleScript,
            # so quotes and newlines in a message cannot break the script.
            script = ("on run argv\n"
                      "display notification (item 1 of argv) "
                      "with title (item 2 of argv) subtitle (item 3 of argv)")
            if sound:
                script += " sound name (item 4 of argv)"
            script += "\nend run"
            cmd = ["osascript", "-e", script, "--", message, title, subtitle]
            if sound:
                cmd.append(sound)
        _spawn(cmd)

    if cfg.get("speak"):
        spoken = f"{title}. {subtitle}. {message}" if subtitle else f"{title}. {message}"
        say = ["say"]
        if cfg.get("voice"):
            say += ["-v", cfg["voice"]]
        say.append(spoken)
        _spawn(say)


def sound_for(cfg: dict, ntype: str) -> str:
    sounds = cfg.get("sounds", {})
    return sounds.get(ntype, sounds.get("default", ""))


def emit(cfg: dict, sess: dict, *, reminder: bool = False) -> None:
    ntype = sess.get("notification_type", "unknown")
    title = TITLES.get(ntype, "Claude Code")
    project = sess.get("project") or "Claude Code"
    message = (sess.get("message") or "").strip() or title

    subtitle = project
    if reminder:
        waited = fmt_duration(time.time() - sess.get("since", time.time()))
        subtitle = f"{project} (waiting {waited})"

    click = ""
    if sess.get("session_id"):
        click = f'{shell_quote(str(SELF))} focus {shell_quote(sess["session_id"])}'

    notify(
        cfg,
        title=title,
        subtitle=subtitle,
        message=message,
        group=f"claude-watch-{sess.get('session_id', 'unknown')}",
        sound=sound_for(cfg, ntype),
        click=click,
    )


def shell_quote(value: str) -> str:
    return "'" + value.replace("'", "'\\''") + "'"


def fmt_duration(seconds: float) -> str:
    seconds = int(max(0, seconds))
    if seconds < 60:
        return f"{seconds}s"
    minutes, seconds = divmod(seconds, 60)
    if minutes < 60:
        return f"{minutes}m {seconds}s"
    hours, minutes = divmod(minutes, 60)
    return f"{hours}h {minutes}m"


def _note_error(message: str) -> None:
    try:
        WATCH_HOME.mkdir(parents=True, exist_ok=True)
        with open(ERROR_PATH, "a") as fh:
            fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n")
    except OSError:
        pass


# --------------------------------------------------------------------------
# focusing a terminal
# --------------------------------------------------------------------------

TERMINAL_FOCUS = '''
on run argv
  set theTty to item 1 of argv
  tell application "Terminal"
    activate
    repeat with w in windows
      repeat with t in tabs of w
        try
          if tty of t is theTty then
            set selected of t to true
            set frontmost of w to true
            return "ok"
          end if
        end try
      end repeat
    end repeat
  end tell
  return "notfound"
end run
'''

ITERM_FOCUS = '''
on run argv
  set theTty to item 1 of argv
  tell application "iTerm2"
    activate
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          try
            if tty of s is theTty then
              select w
              select t
              select s
              return "ok"
            end if
          end try
        end repeat
      end repeat
    end repeat
  end tell
  return "notfound"
end run
'''


def _focus_windows(sess: dict) -> str:
    """Raise the window of the nearest ancestor of the session that has one."""
    pid = sess.get("pid")
    if not pid:
        return "no process recorded for this session"
    table = _proc_table()
    ancestors = []
    for _ in range(12):
        ancestors.append(pid)
        row = table.get(pid)
        if row is None or row[0] <= 0:
            break
        pid = row[0]

    user32 = ctypes.WinDLL("user32")
    callback = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
    user32.EnumWindows.argtypes = [callback, wintypes.LPARAM]
    user32.GetWindowThreadProcessId.argtypes = [wintypes.HWND, ctypes.POINTER(wintypes.DWORD)]
    for fn in (user32.IsWindowVisible, user32.GetWindowTextLengthW,
               user32.IsIconic, user32.SetForegroundWindow):
        fn.argtypes = [wintypes.HWND]
    user32.ShowWindow.argtypes = [wintypes.HWND, ctypes.c_int]

    windows: dict[int, int] = {}

    def each(hwnd, _):
        if user32.IsWindowVisible(hwnd) and user32.GetWindowTextLengthW(hwnd):
            owner = wintypes.DWORD()
            user32.GetWindowThreadProcessId(hwnd, ctypes.byref(owner))
            windows.setdefault(owner.value, hwnd)
        return True

    user32.EnumWindows(callback(each), 0)
    for pid in ancestors:
        hwnd = windows.get(pid)
        if hwnd:
            if user32.IsIconic(hwnd):
                user32.ShowWindow(hwnd, 9)  # SW_RESTORE
            if user32.SetForegroundWindow(hwnd):
                return "focused"
            return "Windows would not hand over focus; the window's taskbar button is flashing"
    return "could not find a terminal window for this session"


def focus_session(sess: dict) -> str:
    if IS_WINDOWS:
        return _focus_windows(sess)

    pane = sess.get("tmux_pane")
    if pane and shutil.which("tmux"):
        subprocess.run(["tmux", "select-pane", "-t", pane],
                       capture_output=True, text=True)
        subprocess.run(["tmux", "select-window", "-t", pane],
                       capture_output=True, text=True)

    tty = sess.get("tty")
    if not tty:
        return "no tty recorded for this session"

    app = (sess.get("term_app") or "").lower()
    if "iterm" in app:
        script = ITERM_FOCUS
    elif "apple_terminal" in app or not app:
        script = TERMINAL_FOCUS
    else:
        return f"don't know how to focus {sess.get('term_app')}"

    result = subprocess.run(["osascript", "-e", script, "--", tty],
                            capture_output=True, text=True)
    out = (result.stdout or result.stderr).strip()
    return "focused" if out == "ok" else f"could not focus {tty}: {out or 'no match'}"


# --------------------------------------------------------------------------
# the hook entry point
# --------------------------------------------------------------------------

def _session_defaults(sess: dict, payload: dict) -> None:
    cwd = payload.get("cwd") or sess.get("cwd") or ""
    sess["session_id"] = payload.get("session_id", sess.get("session_id", "unknown"))
    sess["cwd"] = cwd
    sess["project"] = Path(cwd).name or cwd or "unknown"
    sess["permission_mode"] = payload.get("permission_mode", sess.get("permission_mode"))
    sess["transcript_path"] = payload.get("transcript_path", sess.get("transcript_path"))
    sess["updated"] = time.time()
    if not sess.get("tty") and not sess.get("pid"):
        sess.update(terminal_identity())


def hook_notification(cfg: dict, payload: dict) -> None:
    ntype = payload.get("notification_type") or "unknown"
    message = (payload.get("message") or "").strip()
    now = time.time()

    def mutate(state):
        sess = state["sessions"].setdefault(payload.get("session_id", "unknown"), {})
        was_waiting = sess.get("status") == "waiting"
        previous_type = sess.get("notification_type")
        _session_defaults(sess, payload)
        sess["notification_type"] = ntype
        sess["message"] = message

        if ntype in WAITING_TYPES:
            if not was_waiting or previous_type != ntype:
                sess["since"] = now
                sess["notify_count"] = 0
            sess["status"] = "waiting"
            sess["last_notified"] = now
            sess["notify_count"] = sess.get("notify_count", 0) + 1
        else:
            sess["status"] = "idle"
            sess.pop("since", None)
            sess["notify_count"] = 0
        return dict(sess)

    sess = with_state(mutate)
    log_event({
        "event": "notification",
        "notification_type": ntype,
        "session_id": sess.get("session_id"),
        "project": sess.get("project"),
        "cwd": sess.get("cwd"),
        "message": message,
        "waiting": ntype in WAITING_TYPES,
    })

    if cfg["notify"].get(ntype, True):
        emit(cfg, sess)


def hook_resolved(payload: dict, reason: str) -> None:
    """Something happened that means the session is no longer blocked."""
    if not WAITING_MARKER.exists():
        return  # hot path: nothing is blocked, so there is nothing to clear
    sid = payload.get("session_id", "unknown")
    now = time.time()

    def mutate(state):
        sess = state["sessions"].get(sid)
        if not sess or sess.get("status") != "waiting":
            return None
        waited = now - sess.get("since", now)
        resolved = {
            "session_id": sid,
            "project": sess.get("project"),
            "notification_type": sess.get("notification_type"),
            "message": sess.get("message"),
            "waited_seconds": round(waited, 1),
            "reminders": max(0, sess.get("notify_count", 1) - 1),
        }
        sess["status"] = "idle"
        sess["updated"] = now
        sess["notify_count"] = 0
        sess.pop("since", None)
        return resolved

    resolved = with_state(mutate)
    if resolved:
        resolved["event"] = "resolved"
        resolved["by"] = reason
        log_event(resolved)


def hook_session_start(payload: dict) -> None:
    def mutate(state):
        sess = state["sessions"].setdefault(payload.get("session_id", "unknown"), {})
        sess.update(terminal_identity())
        _session_defaults(sess, payload)
        sess["status"] = "idle"
        sess["started"] = time.time()
        sess["source"] = payload.get("source", "")
        sess["model"] = payload.get("model", "")
        sess["notify_count"] = 0
        sess.pop("since", None)
    with_state(mutate)


def hook_session_end(payload: dict) -> None:
    sid = payload.get("session_id", "unknown")

    def mutate(state):
        return state["sessions"].pop(sid, None)

    sess = with_state(mutate)
    if sess:
        log_event({"event": "session_end", "session_id": sid,
                   "project": sess.get("project"),
                   "reason": payload.get("reason", "")})


def hook_stop(cfg: dict, payload: dict) -> None:
    hook_resolved(payload, "Stop")
    if not cfg.get("notify_on_stop"):
        return

    def mutate(state):
        sess = state["sessions"].setdefault(payload.get("session_id", "unknown"), {})
        _session_defaults(sess, payload)
        sess["notification_type"] = "agent_completed"
        sess["message"] = "Claude finished responding."
        return dict(sess)

    emit(cfg, with_state(mutate))


def cmd_hook(args: list[str]) -> int:
    raw = "" if sys.stdin.isatty() else sys.stdin.buffer.read().decode("utf-8", "replace")
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except ValueError:
        payload = {}
    event = payload.get("hook_event_name") or (args[0] if args else "")
    try:
        cfg = load_config()
        if event == "Notification":
            hook_notification(cfg, payload)
        elif event == "SessionStart":
            hook_session_start(payload)
        elif event == "SessionEnd":
            hook_session_end(payload)
        elif event == "Stop":
            hook_stop(cfg, payload)
        elif event in ("PostToolUse", "UserPromptSubmit", "PreToolUse"):
            hook_resolved(payload, event)
    except Exception as exc:  # a broken watcher must never break a session
        _note_error(f"{event or 'hook'}: {type(exc).__name__}: {exc}")
    # Stay silent in the transcript, and always succeed.
    print(json.dumps({"suppressOutput": True}))
    return 0


# --------------------------------------------------------------------------
# reaping: re-notify long waits, forget dead sessions
# --------------------------------------------------------------------------

def cmd_reap(args: list[str]) -> int:
    cfg = load_config()
    now = time.time()
    reminders: list[dict] = []
    dropped: list[tuple[str, dict, str]] = []

    def mutate(state):
        for sid, sess in list(state["sessions"].items()):
            if not pid_alive(sess.get("pid")):
                dropped.append((sid, state["sessions"].pop(sid), "process gone"))
                continue
            if now - sess.get("updated", now) > cfg["stale_session_seconds"]:
                dropped.append((sid, state["sessions"].pop(sid), "stale"))
                continue
            if sess.get("status") != "waiting":
                continue
            renag = cfg.get("renag_seconds", 0)
            if not renag:
                continue
            if sess.get("notify_count", 0) > cfg.get("renag_max", 0):
                continue
            sent = max(0, sess.get("notify_count", 1) - 1)
            gap = renag * max(1, cfg.get("renag_backoff", 1)) ** sent
            if now - sess.get("last_notified", 0) >= gap:
                sess["last_notified"] = now
                sess["notify_count"] = sess.get("notify_count", 0) + 1
                reminders.append(dict(sess))

    with_state(mutate)

    for sid, sess, why in dropped:
        log_event({"event": "dropped", "session_id": sid,
                   "project": sess.get("project"), "reason": why})
    for sess in reminders:
        log_event({"event": "reminder", "session_id": sess.get("session_id"),
                   "project": sess.get("project"),
                   "notification_type": sess.get("notification_type"),
                   "waited_seconds": round(now - sess.get("since", now), 1)})
        emit(cfg, sess, reminder=True)

    if "--verbose" in args:
        print(f"{len(reminders)} reminder(s), {len(dropped)} session(s) dropped")
    return 0


def cmd_daemon(args: list[str]) -> int:
    interval = 30
    if "--interval" in args:
        interval = max(5, int(args[args.index("--interval") + 1]))
    print(f"claude-watch daemon: reaping every {interval}s (ctrl-c to stop)")
    try:
        while True:
            cmd_reap([])
            time.sleep(interval)
    except KeyboardInterrupt:
        print("\nstopped")
    return 0


